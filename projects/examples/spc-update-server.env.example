# Install as /etc/scdeploy/apps/spc-update-server.env, root:root, mode 0600.
# Replace the database/user/password placeholders before starting the service.
# Systemd reads this file before switching to the unprivileged runtime user.
Database__Provider=Postgre
ConnectionStrings__Postgre="Host=127.0.0.1;Port=5432;Database=REPLACE_DATABASE;Username=REPLACE_USER;Password=REPLACE_PASSWORD"

# Optional first administrator. Supply a new private password only when needed.
# Authentication__Admin__UserName=REPLACE_ADMIN_LOGIN
# Authentication__Admin__Password=REPLACE_ADMIN_PASSWORD

# Optional overrides for listener/storage; these override the unit defaults.
# ASPNETCORE_URLS=http://127.0.0.1:5151
# Storage__WorkingDirectory=/var/lib/spc-update-server/work
# Storage__ReleaseDataDirectory=/var/lib/spc-update-server/packages
